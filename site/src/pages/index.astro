---
import Base from '../layouts/Base.astro';
import { label, readIndex } from '../lib/data';
import { entryPath, withSlash } from '../lib/links';
import { isStale } from '../lib/stale';
import { ui } from '../ui';

const index = readIndex();
const base = withSlash(import.meta.env.BASE_URL);
const tax = index.taxonomy;
const facets = [
  { key: 'type', title: ui.facets.type, values: tax.types, labels: tax.labels_et.type },
  { key: 'domain', title: ui.facets.domain, values: tax.domains, labels: tax.labels_et.domain },
  { key: 'audience', title: ui.facets.audience, values: tax.audiences, labels: tax.labels_et.audience },
  { key: 'works_with', title: ui.facets.works_with, values: tax.works_with, labels: tax.labels_et.works_with },
];
const now = new Date();
---
<Base title={ui.nav.search}>
  <form class="search" role="search" onsubmit="return false">
    <label for="q" class="visually-hidden">{ui.search.label}</label>
    <input type="search" id="q" name="q" placeholder={ui.search.placeholder} autocomplete="off" />
  </form>
  <div class="browse">
    <aside class="facets" id="facets">
      {facets.map((f) => (
        <fieldset>
          <legend>{f.title}</legend>
          {f.values.map((v) => (
            <label><input type="checkbox" name={f.key} value={v} /> {f.labels[v] ?? v}</label>
          ))}
        </fieldset>
      ))}
      <button type="button" id="clear" class="linklike">{ui.search.clear}</button>
    </aside>
    <section class="results" aria-live="polite">
      <p class="count"><span id="count">{index.entries.length}</span> {ui.search.results}</p>
      <ol id="results" class="entry-list">
        {index.entries.map((e) => (
          <li
            data-url={entryPath(base, e.id)}
            data-type={e.type}
            data-domain={e.domains.join(' ')}
            data-audience={e.audience.join(' ')}
            data-works_with={e.works_with.join(' ')}
            data-text={`${e.title} ${e.summary_et} ${e.summary_en}`.toLowerCase()}
          >
            <div class="entry-row">
              <a href={entryPath(base, e.id)}>{e.title}</a>
              <span class="badge">{label(tax, 'type', e.type)}</span>
              {e.verified
                ? <span class="badge badge-ok">{ui.entry.verified}</span>
                : <span class="badge">{ui.entry.unverified}</span>}
              {e.verified && isStale(e.last_tested, index.stale_after_days, now) && <span class="badge badge-warn">{ui.entry.stale}</span>}
            </div>
            <p class="summary">{e.summary_et}</p>
            <p class="meta">{e.domains.map((d) => label(tax, 'domain', d)).join(', ')}</p>
          </li>
        ))}
      </ol>
      <p id="empty" hidden>{ui.search.noResults}</p>
    </section>
  </div>

  <script>
    // Facets filter the pre-rendered list client side. Free text asks Pagefind for matching URLs;
    // without a Pagefind bundle (astro dev) it falls back to substring matching.
    const rawBase = import.meta.env.BASE_URL;
    const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
    const input = document.getElementById('q') as HTMLInputElement;
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('#results > li'));
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('#facets input[type=checkbox]'));
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;

    type Pagefind = {
      options: (o: object) => Promise<void>;
      init: () => Promise<void>;
      search: (q: string) => Promise<{ results: { data: () => Promise<{ url: string }> }[] }>;
    };
    let pagefind: Pagefind | null | undefined; // undefined = not loaded yet, null = unavailable

    async function loadPagefind(): Promise<Pagefind | null> {
      if (pagefind !== undefined) return pagefind;
      try {
        const pf = (await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`)) as Pagefind;
        await pf.options({ baseUrl: base });
        await pf.init();
        pagefind = pf;
      } catch {
        pagefind = null;
      }
      return pagefind;
    }

    function selected(): Record<string, string[]> {
      const out: Record<string, string[]> = {};
      for (const b of boxes) if (b.checked) (out[b.name] ??= []).push(b.value);
      return out;
    }

    function matchesFacets(li: HTMLLIElement, sel: Record<string, string[]>): boolean {
      return Object.entries(sel).every(([facet, values]) => {
        const have = (li.dataset[facet] ?? '').split(' ');
        return values.some((v) => have.includes(v));
      });
    }

    async function textPredicate(query: string): Promise<(li: HTMLLIElement) => boolean> {
      const q = query.trim().toLowerCase();
      if (!q) return () => true;
      const pf = await loadPagefind();
      if (pf) {
        const search = await pf.search(q);
        const urls = new Set(await Promise.all(search.results.map(async (r) => (await r.data()).url)));
        return (li) => urls.has(li.dataset.url ?? '');
      }
      return (li) => (li.dataset.text ?? '').includes(q);
    }

    let ticket = 0;
    async function apply() {
      const mine = ++ticket;
      const sel = selected();
      const textOk = await textPredicate(input.value);
      if (mine !== ticket) return;
      let shown = 0;
      for (const li of items) {
        const ok = matchesFacets(li, sel) && textOk(li);
        li.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = String(shown);
      empty.hidden = shown > 0;
    }

    input.addEventListener('input', () => void apply());
    for (const b of boxes) b.addEventListener('change', () => void apply());
    document.getElementById('clear')!.addEventListener('click', () => {
      input.value = '';
      for (const b of boxes) b.checked = false;
      void apply();
    });
  </script>
</Base>
